#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
// Path-traced indirect light, shadow visibility, baked-light visibility,
// light from the glows (small spherical area lights, shadowed when glow
// shadows are on) and the lighting signature per GI pixel (ptgi.c's trace pass, with
// hardware ray queries instead of the CPU-built BVH).
layout(local_size_x = 8, local_size_y = 8) in;
#include "rt_paths.glsl"
void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy), size = imageSize(gi_out);
    if (any(greaterThanEqual(g, size))) return;
    vec4 pw = imageLoad(position_in, g);
    if (pw.w < 0.5) {
        imageStore(gi_out, g, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(extra_out, g, vec4(1.0, 0.0, 0.0, 0.0));
        imageStore(signature_out, g, uvec4(0u));
        imageStore(hit_out, g, vec4(0.0));
        return;
    }
    vec3 p = pw.xyz, n = imageLoad(normal_in, g).xyz;
    float z = distance(p, eye);
    rng = uint(g.x) * 1973u + uint(g.y) * 9277u + frame * 26699u;
    float lift = 2.0 + z * 0.002; // off the surface, more with distance (depth precision)
    if (trace_debug == 1) { imageStore(gi_out, g, vec4(n * 0.5 + 0.5, 1.0)); return; }
    if (trace_debug == 3) { imageStore(gi_out, g, vec4(fract(p / 256.0), 1.0)); return; }
    if (trace_debug == 2) {
        float t; int hit; vec2 bc;
        bool any_ = trace(p + n * lift, cosine_direction(n), 8192.0, false, n, 16.0, t, hit, bc);
        imageStore(gi_out, g, any_ ? (t < 8.0 ? vec4(1, 0, 0, 1) : vec4(vec3(t / 1024.0), 1.0)) : vec4(0, 0, 1, 1));
        return;
    }
    vec3 total = vec3(0.0);
    float hit_sum = 0.0, hit_count = 0.0;
    float vis = shadows != 0 ? visibility_with_sun(p + n * lift, n) : 1.0;
    bool cached = false; // the irradiance cell of this point has the light that arrives: no rays
    if (cache_on && pw.w < 1.5 && indirect != 0) {
        vec3 tangent = normalize(cross(abs(n.y) < 0.9 ? vec3(0, 1, 0) : vec3(1, 0, 0), n)), bitangent = cross(n, tangent);
        float cell = cache_cell * exp2(max(floor(log2(max(distance(p, eye) / cache_lod, 1.0))), 0.0));
        vec3 sum = vec3(0.0); float away = 0.0, found = 0.0;
        if (cache_bilinear) { // the four cells around the point along its surface, by their distance
            uint face = cache_face(n); uint axis = face / 2u, a1 = (axis + 1u) % 3u, a2 = (axis + 2u) % 3u;
            vec2 uv = vec2(p[a1], p[a2]) / cell - 0.5, f = fract(uv), base = floor(uv);
            float weight = 0.0;
            for (int k = 0; k < 4; k++) {
                vec2 corner = vec2(float(k & 1), float(k >> 1));
                vec3 q = p;
                q[a1] = (base.x + corner.x + 0.5) * cell; q[a2] = (base.y + corner.y + 0.5) * cell;
                float a;
                vec4 c = cache_read(q, n, vec3(0.0), 1u, a);
                if (c.w < float(cache_min)) continue;
                float w = (corner.x > 0.5 ? f.x : 1.0 - f.x) * (corner.y > 0.5 ? f.y : 1.0 - f.y);
                sum += c.rgb * w; away += a * w; weight += w;
            }
            if (weight > 0.0) { sum /= weight; away /= weight; found = 1.0; }
            if (found == 0.0) { // none of them: the point's own cell
                float a;
                vec4 c = cache_read(p, n, vec3(0.0), 1u, a);
                if (c.w >= float(cache_min)) { sum = c.rgb; away = a; found = 1.0; }
            }
        } else for (int r = 0; r < rays; r++) { // a cell nearby, a different one for each ray (a filter between the cells)
            vec2 j = (vec2(rand(), rand()) - 0.5) * cache_jitter * cell;
            float a;
            vec4 c = cache_read(p, n, tangent * j.x + bitangent * j.y, 1u, a);
            if (c.w < float(cache_min)) c = cache_read(p, n, vec3(0.0), 1u, a); // the shifted cell is not there (an edge): the point's own
            if (c.w >= float(cache_min)) { sum += c.rgb; away += a; found += 1.0; }
        }
        if (found > 0.0) {
            float scale = cache_bilinear ? 1.0 : 1.0 / found; // (bilinear: already the mean)
            total = sum * scale * float(rays);
            hit_sum = away * scale * float(rays); hit_count = float(rays);
            cached = true;
        }
    }
    if (trace_debug == 4) { imageStore(gi_out, g, cached ? vec4(0, 1, 0, 1) : vec4(1, 0, 0, 1)); return; } // the radiance cache: green where the GI came from it
    // (characters and props have no cell of their own: with the cache the rays cost no shadow rays, so they get more of them)
    int ray_count = cache_on && pw.w > 1.5 ? rays * 4 : rays;
    for (int r = 0; r < (indirect != 0 && !cached ? ray_count : 0); r++) {
        vec3 o = p + n * lift, nrm = n, throughput = vec3(1.0);
        for (int b = 0; b < bounces; b++) {
            vec3 d = cosine_direction(nrm);
            float t; int hit; vec2 bc;
            if (!trace(o, d, 8192.0, false, nrm, b == 0 ? 16.0 : 0.0, t, hit, bc)) {
                if (env_sky_on()) { // left the room: the sky's light (NRD: a far hit)
                    total += throughput * env_sky(d);
                    if (b == 0) { hit_sum += 4096.0; hit_count += 1.0; }
                }
                break;
            }
            if (b == 0) { hit_sum += t; hit_count += 1.0; }
            Tri tri = tri_at(hit);
            vec3 y = o + d * t;
            vec3 ny = hit_normal(tri, d);
            if (b == 0 && cache_on && hit < MOVER_BIT) { // the radiance cache has what leaves y, bounces and all
                vec3 tangent = normalize(cross(abs(ny.y) < 0.9 ? vec3(0, 1, 0) : vec3(1, 0, 0), ny)), bitangent = cross(ny, tangent);
                float cell = cache_cell * exp2(max(floor(log2(max(distance(y, eye) / cache_lod, 1.0))), 0.0));
                vec2 j = (vec2(rand(), rand()) - 0.5) * cache_jitter * cell;
                float unused;
                vec4 c = cache_read(y, ny, tangent * j.x + bitangent * j.y, 0u, unused);
                if (c.w >= float(cache_min)) { total += c.rgb; break; }
            }
            vec3 baked;
            vec3 albedo = hit_albedo(tri, bc, baked);
            total += throughput * (albedo * (direct(y + ny * 0.5, ny) + sun_light(y + ny * 0.5, ny)) + baked * baked_bounce);
            throughput *= albedo;
            o = y + ny * 1.0; nrm = ny;
        }
    }
    vec3 gi = total / float(max(cached ? rays : ray_count, 1));
    vec3 glow = emitted(p + n * lift, n);
    if (any(isnan(gi)) || any(isinf(gi))) gi = vec3(0.0);
    if (isnan(vis) || isinf(vis)) vis = 1.0;
    imageStore(gi_out, g, vec4(gi, vis));
    imageStore(hit_out, g, vec4(hit_count > 0.0 ? min(hit_sum / hit_count, 65000.0) : 0.0));

    // Characters and props carry the game's own per-frame lighting, not the
    // room's baked light: only room surfaces take its visibility.
    bool moving_surface = pw.w > 1.5;
    float bvis = baked_shadows != 0 && !moving_surface ? baked_visibility(p + n * lift, n, n) : 1.0;
    if (ao_radius > 0.0 && !moving_surface) bvis *= traced_ao(p + n * lift, n);
    if (isnan(bvis) || isinf(bvis)) bvis = 1.0;
    if (any(isnan(glow)) || any(isinf(glow))) glow = vec3(0.0);
    imageStore(extra_out, g, vec4(bvis, glow));
    uint sig = lighting_signature(p + n * lift, n) | sun_signature(p + n * lift, n);
    imageStore(signature_out, g, uvec4(sig | (touched ? 0x80000000u : 0u)));
}
